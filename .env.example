# ──────────────────────────────────────────────────────────────────────────────
# Mnemo — environment configuration
# Copy to .env (never commit). `scripts/bootstrap.sh` generates this interactively.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Deployment ──────────────────────────────────────────────────────────────
MNEMO_ENV=production                  # production | development
MNEMO_DOMAIN=mnemo.example.com        # used by Caddy for TLS; "localhost" for dev
MNEMO_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
MNEMO_LOG_PII=false                   # true = log full message bodies (debug only)

# ─── Telegram ────────────────────────────────────────────────────────────────
# Get a bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated TG numeric user IDs allowed to use the bot. Required.
# Find your ID by messaging @userinfobot.
MNEMO_ALLOWED_TG_IDS=123456789
# Path prefix for the webhook URL (Caddy strips this). Random per install.
TELEGRAM_WEBHOOK_PATH=/telegram/CHANGEME
# Set to "polling" to skip webhook setup (useful locally / behind NAT).
TELEGRAM_MODE=webhook                 # webhook | polling

# ─── Auth secrets (the bootstrap script generates random values) ─────────────
MNEMO_SERVICE_JWT_SECRET=CHANGEME_32B_HEX_OR_LONGER
MNEMO_WEBHOOK_HMAC_SECRET=CHANGEME_32B_HEX_OR_LONGER
# 32 random bytes, base64-encoded. Used to encrypt integration creds at rest.
MNEMO_ENCRYPTION_KEY=CHANGEME_BASE64_32B

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=mnemo
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=mnemo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                       # blank for local single-instance

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mnemo
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET=mnemo-blobs
MINIO_USE_TLS=false

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://n8n:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGEME
N8N_ENCRYPTION_KEY=CHANGEME_32B_HEX

# ─── AI providers ────────────────────────────────────────────────────────────
# Default LLM provider: "openrouter" | "ollama"
MNEMO_LLM_PROVIDER=openrouter
# OpenRouter: get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-job model routing (override to taste).
MNEMO_MODEL_SUMMARIZE=google/gemini-2.5-flash
MNEMO_MODEL_TAG=google/gemini-2.5-flash
MNEMO_MODEL_RAG=anthropic/claude-sonnet-4.6
MNEMO_MODEL_VISION=openai/gpt-4o

# Ollama (if MNEMO_LLM_PROVIDER=ollama). Reach via host.docker.internal on Mac/Win.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embeddings: "ollama" | "openai"
MNEMO_EMBED_PROVIDER=ollama
MNEMO_EMBED_MODEL=bge-m3              # or text-embedding-3-small for openai
MNEMO_EMBED_DIM=1024                  # bge-m3=1024, text-embedding-3-small=1536
# OpenAI key — only needed if MNEMO_EMBED_PROVIDER=openai
OPENAI_API_KEY=

# ASR (voice) provider — local faster-whisper is the v1 path.
WHISPER_MODEL=base                    # tiny|base|small|medium|large-v3
WHISPER_DEVICE=cpu                    # cpu | cuda (cuda needs GPU + nvidia-docker)
WHISPER_COMPUTE_TYPE=int8             # int8 (CPU) | float16 (GPU) | float32

# Cost guardrails
MNEMO_USER_DAILY_TOKEN_CAP=200000     # soft cap per user per day

# Hybrid search
MNEMO_USE_RERANKER=false
MNEMO_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Limits ──────────────────────────────────────────────────────────────────
MNEMO_MAX_UPLOAD_MB=50
MNEMO_THROTTLE_PER_MIN=10

# ─── Observability ───────────────────────────────────────────────────────────
MNEMO_METRICS_ENABLED=true
MNEMO_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# ─── Integrations (optional, can be set later via /settings) ─────────────────
NOTION_DEFAULT_PARENT_DB=
OBSIDIAN_VAULT_PATH=/data/obsidian
